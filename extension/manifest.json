{
  "manifest_version": 3,
  "name": "SERP Extractor Bridge",
  "version": "2.0.0",
  "description": "Mo tab thu thap SERP ngay trong phien lam viec hien tai va noi voi tool SERP Extractor dang chay tren may.",
  "minimum_chrome_version": "116",
  "_comment_key": "Truong 'key' ghim extension id thanh jcacglefgleiajjchmkgjmjkplekgloi tren MOI may. Neu khong co no, Chrome sinh id theo duong dan cai dat, va trang ghep noi (chrome.runtime.sendMessage toi mot id cu the) se khong tim thay extension. KHONG DUOC doi gia tri nay.",
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  },
  "permissions": [
    "debugger",
    "tabs",
    "windows",
    "downloads",
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SERP Extractor Bridge",
    "default_popup": "popup.html"
  }
}
